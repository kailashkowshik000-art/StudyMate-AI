# ==============================================================================
# StudyMate AI - Backend Environment Configuration Example
# ==============================================================================

# Server Environment ('production' enforces strict JWT security and production validation)
NODE_ENV=development
PORT=5000

# Client Application URL (Required for production CORS whitelist)
# In development: http://localhost:5173
# In production / Docker: http://localhost:3000
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Connection (Phase 6.3 Local MongoDB & Atlas Support)
# ------------------------------------------------------------------------------
# Option A: Windows-hosted local development (Node.js running directly on host):
MONGODB_URI=mongodb://127.0.0.1:27017/studymate_db

# Option B: Docker Compose internal container networking:
# MONGODB_URI=mongodb://mongo:27017/studymate_db

# Option C: Cloud MongoDB Atlas cluster (Production deployment):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/studymate_db?retryWrites=true&w=majority

# Memory Database Fallback (Strictly false for persistent storage)
USE_MEMORY_DB=false

# Node.js DNS Resolver Configuration
# Use 'system' for local MongoDB / Docker; use '8.8.8.8,8.8.4.4' for Atlas on Windows
DNS_SERVERS=system

# Authentication Modernization & Session Security (Phase 8.2)
# ------------------------------------------------------------------------------
# Access Token Secret (Short-lived 10-15 minute JWT)
ACCESS_TOKEN_SECRET=your_generated_cryptographically_secure_access_token_secret_32_chars_min
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh Token Secret (Longer-lived 7-day JWT / Session Token)
REFRESH_TOKEN_SECRET=your_generated_cryptographically_secure_refresh_token_secret_32_chars_min
REFRESH_TOKEN_EXPIRES_IN=7d

# Legacy JWT secret for backward compatibility
JWT_SECRET=your_generated_cryptographically_secure_random_jwt_secret_key_here
JWT_EXPIRE=7d

# Cookie Security Configuration
# Set COOKIE_SECURE=true for HTTPS in production; defaults to true when NODE_ENV=production
COOKIE_SECURE=false
# SameSite policy: 'lax' (recommended for cross-origin SPA) or 'strict' (same-origin)
COOKIE_SAME_SITE=lax

# Resend Transactional Email Infrastructure (Phase 8.3)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Verified sender identity (e.g. StudyMate AI <onboarding@resend.dev> or StudyMate AI <noreply@yourdomain.com>)
EMAIL_FROM=StudyMate AI <onboarding@resend.dev>

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768

# RAG & Chunking Parameters
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150
MAX_FILE_SIZE=26214400

# Cloudflare R2 / S3-Compatible Object Storage Configuration (Phase 8.1)
# ------------------------------------------------------------------------------
# Storage provider selection: 'local' (default for development) or 'r2' (production cloud)
STORAGE_PROVIDER=local

# Cloudflare R2 Credentials (Required when STORAGE_PROVIDER=r2)
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=studymate-documents
# R2_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if omitted
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Optional: public custom domain for CDN-delivered assets (leave empty for private buckets)
R2_PUBLIC_URL=

# Redis & BullMQ Distributed Document Processing (Phase 8.5)
# ------------------------------------------------------------------------------
# Redis connection host & port (Defaults to 127.0.0.1:6379 for local development)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false

# Full Redis Connection URI (Optional alternative; e.g. for Upstash / AWS ElastiCache / Redis Cloud)
# REDIS_URL=redis://default:password@cluster-host:6379
# REDIS_URL=rediss://default:password@cluster-host:6380 (TLS)
REDIS_URL=

# BullMQ Queue Concurrency & Worker Tuning
QUEUE_CONCURRENCY=2
QUEUE_MAX_RETRIES=3
QUEUE_BACKOFF_DELAY=5000
