{
  "name": "studymate-ai-backend",
  "version": "1.0.0",
  "description": "StudyMate AI Backend REST API with Express & MongoDB",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_phase4.js')\"",
    "test:phase2": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_backend.js')\"",
    "test:phase3": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_phase3.js')\"",
    "test:phase4": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_phase4.js')\"",
    "test:security": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_security.js')\"",
    "test:phase5.3": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_phase5_3.js')\"",
    "test:phase5.4": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_phase5_4.js')\"",
    "test:phase6": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_phase6_master.js')\"",
    "test:multiformat": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_multiformat.js')\"",
    "test:notes": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_comprehensive_notes.js')\"",
    "test:dns": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_dns_resolver.js')\"",
    "test:storage": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_storage_r2.js')\"",
    "test:auth": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_auth_modernization.js')\"",
    "test:email": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_email_recovery.js')\"",
    "test:account": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_account_privacy.js')\"",
    "test:queue": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_redis_bullmq.js')\"",
    "test:ui": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_frontend_polish.js')\"",
    "test:notes:advanced": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_advanced_learning_notes.js')\"",
    "test:qa": "node -e \"process.env.NODE_ENV='test'; import('./tests/verify_learning_quality_qa.js')\"",
    "test:all": "npm run test:dns && npm run test:security && npm run test:phase5.3 && npm run test:phase5.4 && npm run test:phase6 && npm run test:multiformat && npm run test:notes && npm run test:notes:advanced && npm run test:qa && npm run test:storage && npm run test:auth && npm run test:email && npm run test:account && npm run test:queue && npm run test:ui",
    "migrate": "node scripts/migrate_database.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/s3-request-presigner": "^3.1173.0",
    "@google/generative-ai": "^0.24.1",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.7.8",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "mongoose": "^8.9.5",
    "multer": "^1.4.5-lts.1",
    "officeparser": "^8.4.1",
    "pdf-parse": "^2.4.5",
    "resend": "^6.39.0",
    "uuid": "^11.0.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.3"
  }
}
