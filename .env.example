# ==============================================================================
# StudyMate AI - Production Environment Variables Example (v1.0.0)
# Copy this file to .env and replace placeholders with production credentials.
# NEVER commit your actual .env file or credentials to source control.
# ==============================================================================

# 1. Server Environment & Application URLs
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
BACKEND_PORT=5000
FRONTEND_PORT=3000

# Allowed CORS Origin (Must match your deployed frontend URL exactly)
CLIENT_URL=https://your-domain.com
FRONTEND_URL=https://your-domain.com
BACKEND_URL=https://api.your-domain.com

# 2. MongoDB Atlas Persistent Database Connection
# ------------------------------------------------------------------------------
# Requirements:
# 1. Must use mongodb+srv:// protocol.
# 2. Must target studymate_db (or your chosen database name).
# 3. Must include retryWrites=true&w=majority.
# 4. Strictly cannot be localhost, 127.0.0.1, or memory DB in production.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-name>.mongodb.net/studymate_db?retryWrites=true&w=majority&appName=StudyMateAI
USE_MEMORY_DB=false

# Node.js DNS Resolver (Use 'system' for Linux/Docker; '8.8.8.8,8.8.4.4' for Atlas on Windows)
DNS_SERVERS=system

# 3. Authentication Modernization & Session Security (Phase 8.2)
# ------------------------------------------------------------------------------
# Generate 32-byte cryptographically secure random keys via:
# node -e "console.log(crypto.randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=your_generated_cryptographically_secure_access_token_secret_32_chars_min
ACCESS_TOKEN_EXPIRES_IN=15m

REFRESH_TOKEN_SECRET=your_generated_cryptographically_secure_refresh_token_secret_32_chars_min
REFRESH_TOKEN_EXPIRES_IN=7d

# Legacy JWT secret for backward-compatible verification
JWT_SECRET=your_generated_cryptographically_secure_random_jwt_secret_key_here
JWT_EXPIRE=7d

# Cookie Security Configuration
# Set COOKIE_SECURE=true for HTTPS in production (default is true when NODE_ENV=production)
COOKIE_SECURE=true
# SameSite policy: 'lax' (recommended for standard SPA) or 'strict' (same-origin)
COOKIE_SAME_SITE=lax

# 4. Resend Transactional Email Infrastructure (Phase 8.3)
# ------------------------------------------------------------------------------
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sender identity (e.g., StudyMate AI <noreply@yourdomain.com>)
EMAIL_FROM=StudyMate AI <noreply@yourdomain.com>

# 5. Cloudflare R2 / S3-Compatible Object Storage (Phase 8.1)
# ------------------------------------------------------------------------------
# Set 'r2' for production cloud storage; 'local' for local development filesystem
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=studymate-documents
# R2_ENDPOINT defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com if omitted
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
# Optional: public custom CDN domain (leave empty for private buckets)
R2_PUBLIC_URL=

# 6. Redis & BullMQ Distributed Document Processing (Phase 8.5)
# ------------------------------------------------------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_TLS=false
# Alternatively, specify a full Redis URI (e.g., Upstash / Redis Cloud / AWS ElastiCache):
# REDIS_URL=rediss://default:password@cluster-host:6380
QUEUE_CONCURRENCY=2

# 7. Google Gemini AI API Configuration
# ------------------------------------------------------------------------------
# Obtain an API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768
